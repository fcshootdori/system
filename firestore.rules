rules_version = '2';
// 슛도리 Firestore 보안 규칙
//  - 앱을 통해 접속한 사용자(익명 로그인)만 쓰기 가능
//  - auth: 회원 비밀번호 열쇠 문서. 문서 이름(= 닉네임·비밀번호로 만든 열쇠)을 알 때만 읽을 수 있고, 목록 조회는 막음
//  - authset: 회원별 비밀번호 등록 여부·버전 (누구나 읽기)
service cloud.firestore {
  match /databases/{database}/documents {
    match /meta/{doc}      { allow read: if true; allow write: if request.auth != null; }
    match /members/{id}    { allow read: if true; allow write: if request.auth != null; }
    match /matchdays/{id}  { allow read: if true; allow write: if request.auth != null; }
    match /games/{id}      { allow read: if true; allow write: if request.auth != null; }
    match /authset/{id}    { allow read: if true; allow write: if request.auth != null; }
    match /auth/{key} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, delete: if request.auth != null;
      allow update: if false;
    }
    match /{path=**}       { allow read, write: if false; }
  }
}
